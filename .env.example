# 复制为 .env 后按需修改；.env 不要提交到 Git
# cp .env.example .env

# ---- 本站 ----
# 宿主机访问端口
HOST_PORT=8899
# 网站访问密码。留空 = 不启用密码认证（不推荐）
AUTH_PASSWORD=
# 登录状态保留天数，默认 30
AUTH_DAYS=30

# ---- 汇率（可选）----
# 不填则使用设置页里保存的值；设置页选「自动获取」时会定时更新
# FX_USD_CNY=7.10
# FX_HKD_CNY=0.92

# 说明：投资组合（理财持仓）已内置在本项目中，数据存在同一个 SQLite，
# 不再需要配置任何外部数据库路径或接口地址。
