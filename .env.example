# 复制为 .env 后按需修改；.env 不要提交到 Git
# cp .env.example .env

# ---- 本站 ----
# 宿主机访问端口
HOST_PORT=8899
# 网站访问密码。留空 = 不启用密码认证（不推荐）
AUTH_PASSWORD=
# 登录状态保留天数，默认 30
AUTH_DAYS=30

# ---- 理财数据源：portfolio-tracker（投资组合收益统计） ----
# 三选一：manual（手动填）/ api（走它的 HTTP 接口）/ db（同机只读它的 SQLite）
PORTFOLIO_MODE=manual

# api 模式：你的 portfolio-tracker 地址与访问密码
PORTFOLIO_BASE_URL=http://127.0.0.1:8888
PORTFOLIO_PASSWORD=

# db 模式：portfolio-tracker 的数据库文件路径（需能只读访问）
PORTFOLIO_DB=../portfolio-tracker/data/portfolio.db
